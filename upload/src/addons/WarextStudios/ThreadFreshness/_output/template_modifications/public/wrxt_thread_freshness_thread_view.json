{
    "template": "thread_view",
    "description": "Konu güncellik doğrulama panelini konu görünümüne ekler",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#<xf:ad position=\"thread_view_below_messages\" arg-thread=\"\\{\\$thread\\}\" />#",
    "replace": "<xf:if is=\"$thread.wrxtFreshnessIsEligible()\">\n\t<xf:set var=\"$wrxtState\" value=\"{$thread.wrxtFreshnessGetState()}\" />\n\t<xf:set var=\"$wrxtVisitorVote\" value=\"{$thread.wrxtFreshnessGetVisitorVote()}\" />\n\t<div class=\"block\" id=\"wrxt-thread-freshness\">\n\t\t<div class=\"block-container\">\n\t\t\t<h3 class=\"block-header\">Bu çözüm hâlâ geçerli mi?</h3>\n\t\t\t<div class=\"block-body\">\n\t\t\t\t<div class=\"block-row\">\n\t\t\t\t\t<div>Bu konu uzun süredir güncellenmedi. Çözümü gerçekten denediyseniz güncellik durumunu bildirebilirsiniz.</div>\n\t\t\t\t\t<xf:if is=\"$wrxtState\">\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\"><dt>Çalıştı</dt><dd>{$wrxtState.positive_count}</dd></dl>\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\"><dt>Çalışmadı</dt><dd>{$wrxtState.negative_count}</dd></dl>\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\">\n\t\t\t\t\t\t\t<dt>Topluluk durumu</dt>\n\t\t\t\t\t\t\t<dd>\n\t\t\t\t\t\t\t\t<xf:if is=\"$wrxtState.status == 'current'\">\n\t\t\t\t\t\t\t\t\tGüncel\n\t\t\t\t\t\t\t\t<xf:elseif is=\"$wrxtState.status == 'likely_current'\" />\n\t\t\t\t\t\t\t\t\tMuhtemelen güncel\n\t\t\t\t\t\t\t\t<xf:elseif is=\"$wrxtState.status == 'mixed'\" />\n\t\t\t\t\t\t\t\t\tKararsız\n\t\t\t\t\t\t\t\t<xf:elseif is=\"$wrxtState.status == 'questionable'\" />\n\t\t\t\t\t\t\t\t\tGüncelliği şüpheli\n\t\t\t\t\t\t\t\t<xf:elseif is=\"$wrxtState.status == 'not_working'\" />\n\t\t\t\t\t\t\t\t\tArtık çalışmıyor\n\t\t\t\t\t\t\t\t<xf:else />\n\t\t\t\t\t\t\t\t\tDoğrulanmamış\n\t\t\t\t\t\t\t\t</xf:if>\n\t\t\t\t\t\t\t</dd>\n\t\t\t\t\t\t</dl>\n\t\t\t\t\t<xf:else />\n\t\t\t\t\t\t<div class=\"formRow-explain\">Doğrulanmamış</div>\n\t\t\t\t\t</xf:if>\n\t\t\t\t</div>\n\t\t\t\t<xf:if is=\"$thread.wrxtFreshnessCanVote()\">\n\t\t\t\t\t<div class=\"block-row\">\n\t\t\t\t\t\t<xf:form action=\"{{ link('threads/freshness-vote', $thread) }}\" ajax=\"true\">\n\t\t\t\t\t\t\t<xf:textboxrow name=\"version\" maxlength=\"100\" label=\"Denediğiniz sürüm\" />\n\t\t\t\t\t\t\t<xf:selectrow name=\"reason\" label=\"Çalışmama nedeni\">\n\t\t\t\t\t\t\t\t<xf:option value=\"\">Seçmek istemiyorum</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"outdated_version\">Yeni sürümde çalışmıyor</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"dead_links\">Dosya veya bağlantılar çalışmıyor</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"method_invalid\">Yöntem artık geçerli değil</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"incomplete\">Çözüm eksik</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"did_not_work\">Benim sistemimde çalışmadı</xf:option>\n\t\t\t\t\t\t\t\t<xf:option value=\"other\">Diğer</xf:option>\n\t\t\t\t\t\t\t</xf:selectrow>\n\t\t\t\t\t\t\t<xf:textboxrow name=\"message\" maxlength=\"500\" label=\"Kısa açıklama\" />\n\t\t\t\t\t\t\t<div class=\"formSubmitRow\">\n\t\t\t\t\t\t\t\t<div class=\"formSubmitRow-main\">\n\t\t\t\t\t\t\t\t\t<div class=\"formSubmitRow-bar\"></div>\n\t\t\t\t\t\t\t\t\t<div class=\"formSubmitRow-controls\">\n\t\t\t\t\t\t\t\t\t\t<xf:button type=\"submit\" name=\"vote\" value=\"1\" class=\"button--primary\">Denedim, çalıştı</xf:button>\n\t\t\t\t\t\t\t\t\t\t<xf:button type=\"submit\" name=\"vote\" value=\"-1\">Denedim, çalışmadı</xf:button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<xf:if is=\"$wrxtVisitorVote == 1\">\n\t\t\t\t\t\t\t\t<div class=\"formRow-explain\">Mevcut oyunuz: çalıştı</div>\n\t\t\t\t\t\t\t<xf:elseif is=\"$wrxtVisitorVote == -1\" />\n\t\t\t\t\t\t\t\t<div class=\"formRow-explain\">Mevcut oyunuz: çalışmadı</div>\n\t\t\t\t\t\t\t</xf:if>\n\t\t\t\t\t\t</xf:form>\n\t\t\t\t\t</div>\n\t\t\t\t<xf:else />\n\t\t\t\t\t<div class=\"block-row formRow-explain\">Bu konu için oy kullanma şartlarını karşılamıyorsunuz.</div>\n\t\t\t\t</xf:if>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</xf:if>\n$0"
}